---
layout: default
---
{% assign home_parts = content | split: '<!-- research-section -->' %}
<article class="academic-home">
  <section id="about" class="home-intro" aria-labelledby="profile-name">
    <div class="home-biography">
      <h1 id="profile-name">
        {{ page.display_name | default: site.first_name -}}
        {%- unless page.display_name %} {{ site.last_name }}{% endunless %}
      </h1>
      {{ home_parts[0] }}
      {% include profile-links.liquid %}
    </div>
    {% if page.profile.image %}
      {% assign profile_path = page.profile.image | prepend: 'assets/img/' %}
      <div class="home-portrait">
        {% include figure.liquid loading="eager" path=profile_path class="portrait-image" sizes="(max-width: 720px) 160px, 200px" alt="Portrait of Yichao Cai" cache_bust=true %}
      </div>
    {% endif %}
  </section>
  <section id="research" class="home-section" aria-labelledby="research-heading">{{ home_parts[1] }}</section>
  {% if page.research %}
    <section id="publications" class="home-section" aria-label="{{ page.publications_heading | default: 'Publications' }}">
      <p class="publication-note">{{ page.publication_note }}</p>
      {% include research_publications.liquid %}
    </section>
  {% endif %}
  {% if page.latest_posts.enabled %}
    <section class="home-section">
      <h2>
        <a href="{{ '/blog/' | relative_url }}">{{ page.latest_posts_heading | default: 'Latest posts' }}</a>
      </h2>
      {% include latest_posts.liquid %}
    </section>
  {% endif %}
  <section id="teaching" class="home-section" aria-labelledby="teaching-heading">
    <h2 id="teaching-heading">
      {% if page.lang == 'zh' %}教学{% else %}Teaching{% endif %}
    </h2>
    {% if page.lang == 'zh' %}
      {% capture teaching_content %}{% include home/teaching_zh.md %}{% endcapture %}
    {% else %}
      {% capture teaching_content %}{% include home/teaching.md %}{% endcapture %}
    {% endif %}
    {{ teaching_content | markdownify }}
  </section>
  <section id="service" class="home-section" aria-labelledby="service-heading">
    <h2 id="service-heading">
      {% if page.lang == 'zh' %}学术服务{% else %}Academic Service{% endif %}
    </h2>
    {% if page.lang == 'zh' %}
      {% capture service_content %}{% include home/service_zh.md %}{% endcapture %}
    {% else %}
      {% capture service_content %}{% include home/service.md %}{% endcapture %}
    {% endif %}
    {{ service_content | markdownify }}
  </section>
</article>
