---
---
{% assign tags = site.data.publication_tags[entry.key] %}
{% assign paper_url = entry.website | default: entry.html %}
{% if entry.arxiv -%}
  {%- assign paper_url = entry.arxiv | prepend: 'https://arxiv.org/abs/' -%}
{%- elsif entry.doi -%}
  {%- assign paper_url = entry.doi | prepend: 'https://doi.org/' -%}
{%- endif %}
<article
  id="{{ entry.key }}"
  class="publication-entry"
  data-year="{{ entry.year }}"
  data-key="{{ entry.key }}"
  data-facets="{{ tags | jsonify | escape }}"
>
  {% if entry.preview %}
    <div class="publication-figure">
      <a href="{{ paper_url }}" aria-label="Read {{ entry.title | escape }}">
        {% if entry.preview contains '://' -%}
          {%- assign preview_url = entry.preview -%}
        {%- else -%}
          {%- assign preview_url = entry.preview | prepend: '/assets/img/publication_preview/' | relative_url -%}
        {%- endif %}
        <img class="preview" src="{{ preview_url }}" alt="Figure from {{ entry.title | escape }}" loading="lazy" decoding="async">
      </a>
    </div>
  {% endif %}
  <div class="publication-content">
    <h3 class="publication-title">
      {% if paper_url -%}
        <a href="{{ paper_url }}">{{ entry.title }}</a>
      {%- else -%}
        {{- entry.title -}}
      {%- endif %}
    </h3>
    <div class="author">
      {% assign author_array_size = entry.author_array | size %}

      {% assign author_array_limit = author_array_size %}
      {% if site.max_author_limit and author_array_size > site.max_author_limit %}
        {% assign author_array_limit = site.max_author_limit %}
      {% endif %}

      {%- for author in entry.author_array limit: author_array_limit -%}
        {% assign author_is_self = false %}
        {%- assign author_von_raw = author.von | default: author.prefix | default: '' -%}
        {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_von_name = author_von_raw | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
        {%- assign author_full_last_name = author_last_name -%}
        {%- if author_von_name != '' -%}
          {%- assign author_full_last_name = author_von_name | append: ' ' | append: author_last_name -%}
        {%- endif -%}
        {%- assign author_von_html = author_von_raw | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        {%- assign author_display_name = author.first | append: ' ' -%}
        {%- if author_von_html != '' -%}
          {%- assign author_display_name = author_display_name | append: author_von_html | append: ' ' -%}
        {%- endif -%}
        {%- assign author_display_name = author_display_name | append: author_last_html -%}
        {% if site.scholar.last_name contains author_full_last_name or site.scholar.last_name contains author_last_name %}
          {% if site.scholar.first_name contains author.first %}
            {% assign author_is_self = true %}
          {% endif %}
        {%- endif -%}
        {% assign coauthor_url = null %}
        {%- assign clean_last_name = author_full_last_name | downcase | remove_accents -%}
        {% if site.data.coauthors[clean_last_name] %}
          {%- for coauthor in site.data.coauthors[clean_last_name] -%}
            {% if coauthor.firstname contains author.first %}
              {%- assign coauthor_url = coauthor.url -%}
              {% break %}
            {%- endif -%}
          {% endfor %}
        {%- endif -%}

        {%- if forloop.length > 1 -%}
          {% if forloop.first == false -%}
            {%- if forloop.length > 2 %}, {% elsif forloop.length == 2 %}  {% endif %}
          {%- endif %}
          {%- if forloop.last and author_array_limit == author_array_size %}and {% endif -%}
        {% endif %}
        {%- if author_is_self -%}
          <strong>
            {{- author_display_name -}}
          </strong>
        {%- else -%}
          {%- if coauthor_url -%}
            <a href="{{ coauthor_url }}">
              {{- author_display_name -}}
            </a>
          {%- else -%}
            {{- author_display_name -}}
          {% endif %}
        {%- endif -%}
      {% endfor %}
      {%- assign more_authors = author_array_size | minus: author_array_limit -%}

      {%- assign more_authors_hide = more_authors | append: ' more author' -%}
      {% if more_authors > 0 %}
        {%- if more_authors > 1 -%}
          {% assign more_authors_hide = more_authors_hide | append: 's' %}
        {%- endif -%}
        {% assign more_authors_show = '' %}
        {%- for author in entry.author_array offset: author_array_limit -%}
          {% assign more_author_von = author.von | default: author.prefix | default: '' %}
          {% assign more_authors_show = more_authors_show | append: author.first | append: ' ' %}
          {% if more_author_von != '' %}
            {% assign more_authors_show = more_authors_show | append: more_author_von | append: ' ' %}
          {% endif %}
          {% assign more_authors_show = more_authors_show | append: author.last %}
          {% unless forloop.last %}
            {% assign more_authors_show = more_authors_show | append: ', ' %}
          {% endunless %}
        {%- endfor -%}
        {%- assign more_authors_show = more_authors_show | regex_replace: '([*∗†‡§¶‖&^]+)', '<sup>\1</sup>' -%}
        , and
        <span
          class="more-authors"
          title="click to view {{ more_authors_hide }}"
          onclick="
              var element = $(this);
              element.attr('title', '');
              var more_authors_text = element.text() == '{{ more_authors_hide }}' ? '{{ more_authors_show }}' : '{{ more_authors_hide }}';
              var cursorPosition = 0;
              var textAdder = setInterval(function(){
                element.html(more_authors_text.substring(0, cursorPosition + 1));
                if (++cursorPosition == more_authors_text.length){
                  clearInterval(textAdder);
                }
            }, '{{ site.more_authors_animation_delay }}');
          "
        >
          {{- more_authors_hide -}}
        </span>
      {% endif %}
    </div>
    <p class="periodical">
      <em>
        {%- if tags.type == 'Preprint' -%}
          Preprint
        {%- elsif entry.booktitle -%}
          {{- entry.booktitle -}}
        {%- elsif entry.journal -%}
          {{- entry.journal -}}
        {%- endif -%}
        , {{ entry.year -}}
      </em>
      {%- if entry.highlight %}
        · <strong class="publication-highlight">{{ entry.highlight }}</strong>
      {%- endif -%}
      {%- if entry.note %} · {{ entry.note }}{% endif %}
    </p>
    <div class="publication-tags" aria-label="Publication tags">
      {% if tags.type -%}
        <span class="pub-tag type" data-tag="{{ tags.type | escape }}">{{ tags.type }}</span>
      {%- endif %}
      {% assign facets = 'methods,topics,domains' | split: ',' -%}
      {%- for facet in facets -%}
        {%- for tag in tags[facet] -%}
          <span class="pub-tag {{ facet }}" data-tag="{{ tag | escape }}">{{ tag }}</span>
        {%- endfor -%}
      {%- endfor %}
    </div>
    <div class="links">
      {% if entry.abstract -%}
        <button
          type="button"
          class="paper-action abstract publication-actions-js"
          data-publication-panel="{{ entry.key }}-abstract"
          aria-controls="{{ entry.key }}-abstract"
          aria-expanded="false"
        >
          Abstract
        </button>
      {%- endif %}
      {% if entry.bibtex_show -%}
        <button
          type="button"
          class="paper-action bib publication-actions-js"
          data-publication-panel="{{ entry.key }}-bib"
          aria-controls="{{ entry.key }}-bib"
          aria-expanded="false"
        >
          Bib
        </button>
      {%- endif %}
      {% if entry.pdf -%}
        {%- if entry.pdf contains '://' -%}
          {%- assign pdf_url = entry.pdf -%}
        {%- else -%}
          {%- assign pdf_url = entry.pdf | prepend: '/assets/pdf/' | relative_url -%}
        {%- endif -%}
        <a class="paper-action pdf" href="{{ pdf_url }}">PDF</a>
      {%- endif %}
      {% if entry.arxiv -%}
        <a class="paper-action arxiv" href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>
      {%- endif %}
      {% if entry.doi -%}
        <a class="paper-action" href="https://doi.org/{{ entry.doi }}">DOI</a>
      {%- endif %}
      {% if entry.code -%}
        <a class="paper-action code" href="{{ entry.code }}">Code</a>
      {%- endif %}
      {% if entry.website -%}
        <a class="paper-action project" href="{{ entry.website }}">Project</a>
      {%- endif %}
      {% if entry.blog -%}
        <a class="paper-action" href="{{ entry.blog | relative_url }}">Blog</a>
      {%- endif %}
      {% assign extra_resources = 'html,supp,video,poster,slides' | split: ',' %}
      {% for resource in extra_resources -%}
        {%- if entry[resource] -%}
          {%- assign resource_url = entry[resource] -%}
          {%- unless resource_url contains '://' -%}
            {%- if resource == 'html' -%}
              {%- assign resource_url = resource_url | prepend: '/assets/html/' | relative_url -%}
            {%- else -%}
              {%- assign resource_url = resource_url | prepend: '/assets/pdf/' | relative_url -%}
            {%- endif -%}
          {%- endunless -%}
          <a class="paper-action" href="{{ resource_url }}">{{ resource }}</a>
        {%- endif -%}
      {%- endfor %}
    </div>
    {% if entry.abstract %}
      <details id="{{ entry.key }}-abstract" class="publication-panel abstract-panel">
        <summary>Abstract</summary>
        <p>{{ entry.abstract }}</p>
        {% if entry.annotation %}
          <p class="author-note">{{ entry.annotation }}</p>
        {% endif %}
      </details>
    {% endif %}
    {% if entry.bibtex_show %}
      <details id="{{ entry.key }}-bib" class="publication-panel">
        <summary>BibTeX</summary>
        <button type="button" class="paper-action publication-actions-js" data-copy-bib="{{ entry.key }}-citation">Copy BibTeX</button
        ><span class="copy-status" role="status"></span>
        <pre id="{{ entry.key }}-citation">{{ entry.bibtex | hideCustomBibtex | escape }}</pre>
      </details>
    {% endif %}
  </div>
</article>
