{% assign blog_name = page.blog_name | default: site.blog_name %}
{% assign blog_description = page.blog_description | default: site.blog_description %}
<div class="blog-index">
  <header class="post-header">
    <h1>{{ blog_name }}</h1>
    <p class="blog-description">{{ blog_description }}</p>
  </header>
  <ul class="blog-topics" aria-label="Topics">
    {% for tag in site.display_tags %}
      <li>
        <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
      </li>
    {% endfor %}
    {% for category in site.display_categories %}
      <li>
        <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>
      </li>
    {% endfor %}
  </ul>
  {% assign featured_posts = site.posts | where: 'featured', true %}
  {% if featured_posts.size > 0 %}
    <section class="featured-essays" aria-labelledby="featured-heading">
      <h2 id="featured-heading">
        {% if page.lang == 'zh' %}精选文章{% else %}Featured essays{% endif %}
      </h2>
      <ul>
        {% for post in featured_posts %}
          <li>{% include post-link.liquid post=post %}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}
  {% assign postlist = site.posts %}
  {% if page.pagination.enabled %}{% assign postlist = paginator.posts %}{% endif %}
  <ol class="post-list">
    {% for post in postlist %}
      <li>
        <h2>{% include post-link.liquid post=post %}</h2>
        <p>{{ post.description }}</p>
        <p class="post-meta">
          <time datetime="{{ post.date | date: '%Y-%m-%d' }}">{{ post.date | date: '%B %-d, %Y' }}</time>
          {%- if post.read_time %}
            · {{ post.read_time }}
            {% if page.lang == 'zh' %}分钟阅读{% else %}min read{% endif -%}
          {%- endif %}
        </p>
        <div class="post-tags">
          {% assign year = post.date | date: '%Y' %}
          <a href="{{ year | prepend: '/blog/' | relative_url }}">{{ year }}</a>
          {% for tag in post.tags -%}
            <a href="{{ tag | slugify | prepend: '/blog/tag/' | relative_url }}">{{ tag }}</a>
          {%- endfor %}
          {% for category in post.categories -%}
            <a href="{{ category | slugify | prepend: '/blog/category/' | relative_url }}">{{ category }}</a>
          {%- endfor %}
        </div>
      </li>
    {% endfor %}
  </ol>
  {% if page.pagination.enabled %}{% include pagination.liquid %}{% endif %}
</div>
