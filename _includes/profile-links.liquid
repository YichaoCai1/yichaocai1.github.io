<div class="profile-links" aria-label="Contact and profiles">
  {% if site.data.socials.email -%}
    <a href="mailto:{{ site.data.socials.email | encode_email }}">Email</a>
  {%- endif %}
  {% if site.data.socials.scholar_userid -%}
    <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Scholar</a>
  {%- endif %}
  {% if site.data.socials.github_username -%}
    <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
  {%- endif %}
  {% if site.data.socials.linkedin_username -%}
    <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn</a>
  {%- endif %}
  {% if site.data.socials.cv_pdf -%}
    <a href="{{ site.data.socials.cv_pdf | relative_url }}">CV</a>
  {%- endif %}
</div>
