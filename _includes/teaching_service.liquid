{% assign current_lang = page.lang | default: site.lang | default: 'en' %}
{% assign current_is_zh = false %}
{% if current_lang == 'zh' or current_lang == 'zh-CN' or current_lang == 'cn' %}
  {% assign current_is_zh = true %}
{% endif %}

{% if current_is_zh %}
  {% capture teaching_content %}{% include_relative teaching.zh.md %}{% endcapture %}
  {% capture academic_service_content %}{% include_relative academic_service.zh.md %}{% endcapture %}
{% else %}
  {% capture teaching_content %}{% include_relative teaching.en.md %}{% endcapture %}
  {% capture academic_service_content %}{% include_relative academic_service.en.md %}{% endcapture %}
{% endif %}

{{ teaching_content | markdownify }}
{{ academic_service_content | markdownify }}
