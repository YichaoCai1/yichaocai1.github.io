{% assign current_lang = page.lang | default: site.lang | default: 'en' %}
{% assign home_url = '/' %}
{% assign blog_url = '/blog/' %}
{% assign nav_labels = 'About,Teaching' | split: ',' %}
{% assign agenda_label = 'Agenda' %}
{% assign blog_label = 'Blog' %}
{% assign menu_label = 'Menu' %}
{% if current_lang == 'zh' %}
  {% assign home_url = '/zh/' %}
  {% assign blog_url = '/zh/blog/' %}
  {% assign nav_labels = '关于,教学' | split: ',' %}
  {% assign agenda_label = '研究议程' %}
  {% assign blog_label = '博客' %}
  {% assign menu_label = '菜单' %}
{% endif %}
{% assign section_ids = 'about,teaching' | split: ',' %}
<header class="academic-header">
  <a class="skip-link" href="#main-content">
    {%- if current_lang == 'zh' %}跳至正文{% else %}Skip to content{% endif -%}
  </a>
  <nav class="academic-nav" aria-label="{% if current_lang == 'zh' %}网站导航{% else %}Site navigation{% endif %}">
    <a class="mobile-brand" href="{{ home_url | relative_url }}">Yichao Cai</a>
    <button class="nav-menu-toggle" type="button" aria-expanded="false" aria-controls="academic-nav-links">
      {{ menu_label }}
      <span aria-hidden="true">☰</span>
    </button>
    <div class="academic-nav-links" id="academic-nav-links">
      {% for section_id in section_ids %}
        <a href="{{ home_url | relative_url }}#{{ section_id }}" data-home-section="{{ section_id }}">{{ nav_labels[forloop.index0] }}</a>
      {% endfor %}
      <span class="nav-divider" aria-hidden="true">|</span>
      <a
        href="{{ '/research-agenda/' | relative_url }}"
        {% if page.url contains '/research-agenda/' %}
          aria-current="page"
        {% endif %}
      >
        {{- agenda_label -}}
      </a>
      <a
        href="{{ blog_url | relative_url }}"
        {% if page.url contains '/blog/' or page.essay %}
          aria-current="page"
        {% endif %}
      >
        {{- blog_label -}}
      </a>
    </div>
    <div class="academic-utilities">
      {% if current_lang == 'zh' %}
        <a href="{{ page.lang_en_url | default: '/' | relative_url }}" lang="en" aria-label="Switch to English">EN</a>
      {% else %}
        <a
          href="{{ page.lang_zh_url | default: '/zh/' | relative_url }}"
          lang="zh"
          aria-label="切换到中文{% if page.essay %}博客列表{% elsif page.url contains '/research-agenda/' %}首页{% endif %}"
          >中</a
        >
      {% endif %}
      {% if site.search_enabled -%}
        <button type="button" id="search-toggle" title="Search (Ctrl K)" aria-label="Search" onclick="openSearchModal()">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        </button>
      {%- endif %}
      {% if site.enable_darkmode -%}
        <button type="button" id="light-toggle" title="Change theme" aria-label="Change theme"><span aria-hidden="true">◐</span></button>
      {%- endif %}
    </div>
  </nav>
</header>
