{% assign current_lang = page.lang | default: site.lang | default: 'en' %}
{% assign home_url = '/' -%}
{%- assign blog_url = '/blog/' -%}
{%- assign teaching_url = '/teaching/' -%}
{%- assign service_url = '/service/' -%}
{%- assign publications_url = '/publications/' %}
{% assign nav_labels = 'Home,Publications,Research,Blog,Teaching,Service' | split: ',' %}
{% if current_lang == 'zh' %}
  {% assign home_url = '/zh/' -%}
  {%- assign blog_url = '/zh/blog/' -%}
  {%- assign teaching_url = '/zh/teaching/' -%}
  {%- assign service_url = '/zh/service/' -%}
  {%- assign publications_url = '/zh/publications/' %}
  {% assign nav_labels = '首页,论文,研究,博客,教学,学术服务' | split: ',' %}
{% endif %}
<header class="academic-header">
  <a class="skip-link" href="#main-content">
    {%- if current_lang == 'zh' %}跳至正文{% else %}Skip to content{% endif -%}
  </a>
  <nav class="academic-nav" aria-label="{% if current_lang == 'zh' %}网站导航{% else %}Site navigation{% endif %}">
    <a class="navbar-brand" href="{{ home_url | relative_url }}">Yichao Cai</a>
    <button
      class="nav-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="academic-nav-links"
      aria-label="{% if current_lang == 'zh' %}展开导航{% else %}Toggle navigation{% endif %}"
    >
      <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
    </button>
    <div class="academic-nav-links" id="academic-nav-links">
      <a
        href="{{ home_url | relative_url }}"
        {% if page.url == home_url %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[0] -}}
      </a>
      <a
        href="{{ publications_url | relative_url }}"
        {% if page.url contains '/publications/' %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[1] -}}
      </a>
      <a
        href="{{ '/research-agenda/' | relative_url }}"
        {% if page.url contains '/research-agenda/' %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[2] -}}
      </a>
      <a
        href="{{ blog_url | relative_url }}"
        {% if page.url contains '/blog/' or page.essay %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[3] -}}
      </a>
      <a
        href="{{ teaching_url | relative_url }}"
        {% if page.url contains '/teaching/' %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[4] -}}
      </a>
      <a
        href="{{ service_url | relative_url }}"
        {% if page.url contains '/service/' %}
          aria-current="page"
        {% endif %}
      >
        {{- nav_labels[5] -}}
      </a>
      {% if current_lang == 'zh' -%}
        <a class="language-switch" href="{{ page.lang_en_url | default: '/' | relative_url }}" lang="en" aria-label="Switch to English">EN</a>
      {% else -%}
        <a class="language-switch" href="{{ page.lang_zh_url | default: '/zh/' | relative_url }}" lang="zh" aria-label="切换到中文">中</a>
      {%- endif %}
      {% if site.enable_darkmode %}
        <button id="theme-toggle" type="button" aria-label="Toggle light/dark mode">
          <span id="theme-toggle-icon" aria-hidden="true">☾</span
          ><span class="label-stack" aria-hidden="true"><span id="label-dark">Dark</span><span id="label-light">Light</span></span>
        </button>
      {% endif %}
    </div>
  </nav>
</header>
